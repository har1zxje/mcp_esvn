PORT=3091
HOST=127.0.0.1

# LibreChat API origin. The browser does not authenticate with LibreChat.
LIBRECHAT_URL=http://127.0.0.1:3080

# Optional server-to-server token for LibreChat. Keep this value server-only.
LIBRECHAT_SERVICE_TOKEN=

# Comma-separated browser origins allowed to call this backend.
CORS_ORIGINS=http://localhost:3090,http://localhost:3080

# The default is used when the UI does not select a model explicitly.
CHAT_DEFAULT_MODEL_ID=gemini_25_flash

# Server-side allowlist. Never put API keys or MCP credentials here.
# Keys are UI model IDs; values identify the LibreChat Agent and its real provider model.
CHAT_MODEL_MAP_JSON={"gemini_flash":{"label":"Gemini 3.5 Flash","agentId":"agent_Bzq3g5Q0bJnC0i_NFPM6D","provider":"google","model":"gemini-3.5-flash"},"gemini_flash_lite":{"label":"Gemini 3.5 Flash Lite","agentId":"agent_Bzq3g5Q0bJnC0i_NFPM6D","provider":"google","model":"gemini-3.5-flash-lite"},"gemini_25_flash":{"label":"Gemini 2.5 Flash","agentId":"agent_Bzq3g5Q0bJnC0i_NFPM6D","provider":"google","model":"gemini-2.5-flash"}}

MCP_SERVERS_JSON={"plane":{"url":"http://127.0.0.1:3003/mcp","transport":"streamable-http"},"discord":{"url":"http://127.0.0.1:3002/mcp","transport":"streamable-http"}, "clickhouse":{"url":"http://127.0.0.1:3001/mcp","transport":"streamable-http"}}
