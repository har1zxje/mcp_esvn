PORT=3091
HOST=127.0.0.1

# LibreChat API origin. The backend forwards the authenticated user's JWT.
LIBRECHAT_URL=http://127.0.0.1:3080

# Optional service credential used only by BE when calling LibreChat.
# The browser does not send or receive this value.
LIBRECHAT_SERVICE_TOKEN=

# Comma-separated browser origins allowed to call this backend.
CORS_ORIGINS=http://localhost:3090,http://localhost:3080

# The default is used when the UI does not select a model explicitly.
CHAT_DEFAULT_MODEL_ID=gemini_flash

# Server-side allowlist. Never put API keys or MCP credentials here.
# Keys are UI model IDs; values identify the LibreChat Agent and its real provider model.
CHAT_MODEL_MAP_JSON={"gemini_flash":{"label":"Gemini 3.5 Flash","agentId":"replace-with-librechat-gemini-agent-id","provider":"google","model":"gemini-3.5-flash"},"gemini_flash_lite":{"label":"Gemini 3.5 Flash Lite","agentId":"replace-with-librechat-gemini-agent-id","provider":"google","model":"gemini-3.5-flash-lite"},"gemini_25_flash":{"label":"Gemini 2.5 Flash","agentId":"replace-with-librechat-gemini-agent-id","provider":"google","model":"gemini-2.5-flash"}}

# Backend-owned MCP registry. Namespaced tools avoid collisions between servers.
MCP_SERVERS_JSON={"plane":{"url":"http://127.0.0.1:3003/mcp","transport":"streamable-http"},"discord":{"url":"http://127.0.0.1:3002/mcp","transport":"streamable-http"}}
MAX_TOOL_ITERATIONS=10
CONTEXT_MESSAGE_LIMIT=24
