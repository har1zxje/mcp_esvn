PORT=3091
HOST=127.0.0.1

# PostgreSQL persistence. Use DATABASE_URL or the individual DB_* values.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mcpserver
DB_USER=postgres
DB_PASSWORD=

# Optional LibreChat origin for non-auth model/UI integration.
LIBRECHAT_URL=http://127.0.0.1:3080

# Optional service credential used only by BE when calling LibreChat.
# The browser does not send or receive this value.
LIBRECHAT_SERVICE_TOKEN=

# Project-owned Google OIDC authentication. LibreChat is not in this trust chain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_CALLBACK_URL=http://localhost:3090/api/auth/google/callback
PROJECT_FRONTEND_URL=http://localhost:3090
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_MS=604800000

# Comma-separated browser origins allowed to call this backend.
CORS_ORIGINS=http://localhost:3090,http://localhost:3080

# Required before saving Plane/Discord user credentials. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never commit the real value.
INTEGRATION_ENCRYPTION_KEY=

# Trusted Plane API origin used only to validate a user-supplied personal API key.
# Do not accept this value from browser requests. For self-hosted Plane, use HTTPS.
PLANE_BASE_URL=https://api.plane.so/
PLANE_VALIDATION_TIMEOUT_MS=10000
# Optional Plane OAuth app. Plane's authorize/token URLs are deployment/app
# specific; leave blank to expose the explicit Advanced PAT fallback.
# Preferred names; PLANE_CLIENT_ID/PLANE_CLIENT_SECRET remain supported aliases.
PLANE_OAUTH_CLIENT_ID=
PLANE_OAUTH_CLIENT_SECRET=
PLANE_OAUTH_AUTHORIZE_URL=
PLANE_OAUTH_TOKEN_URL=
PLANE_OAUTH_REDIRECT_URI=http://localhost:3090/api/integrations/plane/oauth/callback
PLANE_OAUTH_SCOPES=

# Discord OAuth/install configuration. The bot token remains in the Discord
# MCP service configuration and is never stored in integrations.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3090/api/integrations/discord/callback
DISCORD_BOT_PERMISSIONS=2048
DISCORD_DISCOVERY_URL=http://127.0.0.1:3002/internal/discord
OAUTH_STATE_TTL_MS=600000

# The default is used when the UI does not select a model explicitly.
CHAT_DEFAULT_MODEL_ID=gemini_flash

# Server-side allowlist. Never put API keys or MCP credentials here.
# Keys are UI model IDs; values identify the LibreChat Agent and its real provider model.
CHAT_MODEL_MAP_JSON={"gemini_flash":{"label":"Gemini 3.5 Flash","agentId":"replace-with-librechat-gemini-agent-id","provider":"google","model":"gemini-3.5-flash"},"gemini_flash_lite":{"label":"Gemini 3.5 Flash Lite","agentId":"replace-with-librechat-gemini-agent-id","provider":"google","model":"gemini-3.5-flash-lite"},"gemini_25_flash":{"label":"Gemini 2.5 Flash","agentId":"replace-with-librechat-gemini-agent-id","provider":"google","model":"gemini-2.5-flash"}}

# Backend-owned MCP registry. Namespaced tools avoid collisions between servers.
MCP_SERVERS_JSON={"plane":{"url":"http://127.0.0.1:3003/mcp","transport":"streamable-http"},"discord":{"url":"http://127.0.0.1:3002/mcp","transport":"streamable-http"}}
# Shared backend-to-MCP trust token. Configure the same secret in MCP server User Secrets/environment.
MCP_INTERNAL_TOKEN=
DISCORD_VALIDATION_URL=http://127.0.0.1:3002/internal/discord/destination
MAX_TOOL_ITERATIONS=10
CONTEXT_MESSAGE_LIMIT=24
