# Dedicated disposable PostgreSQL database for integration tests only.
# Do not point this at development, shared, or production data.
TEST_DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/hrm_test

# `db:migrate:test` reads DATABASE_URL; it must point to the same isolated DB.
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/hrm_test
HRM_INTERNAL_TOKEN=replace-with-a-test-only-token
TEST_LEGACY_DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/hrm_legacy_identity_test
